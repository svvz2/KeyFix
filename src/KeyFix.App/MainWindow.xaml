<Window x:Class="KeyFix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="KeyFix" Width="1024" Height="680" MinWidth="880" MinHeight="600" SizeToContent="Manual"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}" FlowDirection="RightToLeft"
        Language="ar-IQ">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="7" CornerRadius="12" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Deliberately restrained desktop title bar: no gradients or glow. -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" BorderBrush="#343934" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0" HorizontalAlignment="Left" Panel.ZIndex="10">
                    <Button x:Name="CloseChromeButton" Width="42" Height="34" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="×" FontSize="19" Foreground="#E8E7E1"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Width="42" Height="34" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="MaximizeGlyph" Text="□" FontSize="14" Foreground="#E8E7E1"/>
                    </Button>
                    <Button x:Name="MinimizeChromeButton" Width="42" Height="34" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="—" FontSize="15" Foreground="#E8E7E1"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="K E Y F I X" Foreground="#F7F4EC" FontSize="10" FontWeight="SemiBold"/>
                    <Border Width="4" Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="10,0"/>
                    <TextBlock Text="D E S K T O P" Foreground="#8F958E" FontSize="9"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="232"/>
            </Grid.ColumnDefinitions>

            <!-- Product navigation -->
            <Border Grid.Column="1" Background="{StaticResource SidebarBrush}" BorderBrush="#343934" BorderThickness="1,0,0,0">
                <Grid Margin="18,22,18,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" FlowDirection="RightToLeft">
                        <Border Width="44" Height="44" CornerRadius="11" Background="#F4EFE5">
                            <Grid>
                                <TextBlock Text="K" Foreground="#20231F" FontSize="23" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Width="5" Height="5" CornerRadius="3" Background="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="KeyFix" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource SidebarTextBrush}"/>
                            <TextBlock Text="تخطيطك، كما قصدته" FontSize="10" Foreground="{StaticResource SidebarMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="القائمة" FontSize="10" Foreground="#777E77" Margin="14,0,14,8"/>
                        <Button x:Name="HomeNavButton" Style="{StaticResource NavButton}" Click="HomeNavButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="⌂" FontSize="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Grid.Column="1" Text="الرئيسية" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Grid>
                        </Button>
                        <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="SettingsNavButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="⚙" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Grid.Column="1" Text="الإعدادات" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Grid>
                        </Button>
                        <Button x:Name="AboutNavButton" Style="{StaticResource NavButton}" Click="AboutNavButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="ⓘ" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Grid.Column="1" Text="حول البرنامج" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="3" Background="{StaticResource SidebarRaisedBrush}" BorderBrush="#3B413C" BorderThickness="1"
                            CornerRadius="12" Padding="13">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="حالة النظام" FontSize="10" Foreground="{StaticResource SidebarMutedBrush}"/>
                                <TextBlock Text="{Binding StatusTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SidebarTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="#31483A" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Ellipse Width="7" Height="7" Fill="#69B485"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="0" Background="{StaticResource BackgroundBrush}">
                <!-- Dashboard -->
                <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="30,24,30,30" MaxWidth="980" HorizontalAlignment="Stretch">
                        <TextBlock Text="مساحة العمل" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="أهلاً بك في KeyFix" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="تصحيح فوري لتخطيط الكتابة، من دون أن يقطع تركيزك." FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,14"/>

                        <Border Style="{StaticResource CardStyle}" Padding="18,14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="تواصل ويانا" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ChannelStatusText" Text="نتحقق من أخبار المشروع عبر GitHub…"
                                                   FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="ChannelConnectionBadge" Grid.Column="1" Background="#F0EEE8" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                            <Ellipse x:Name="ChannelConnectionDot" Width="6" Height="6" Fill="#9A9D97" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ChannelConnectionText" Text="GitHub" FontSize="9.5" Foreground="#737872" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,12,0,0" FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="HomeInstagramButton" Grid.Column="0" Content="Instagram  @22r2z"
                                            Style="{StaticResource SecondaryButton}" Click="OpenInstagram_Click" Padding="10,8"/>
                                    <Button x:Name="HomeTelegramButton" Grid.Column="2" Content="Telegram  @Civil_Sajad"
                                            Style="{StaticResource SecondaryButton}" Click="OpenTelegram_Click" Padding="10,8"/>
                                    <Button Grid.Column="4" Content="GitHub  الدعم والملاحظات"
                                            Style="{StaticResource PrimaryButton}" Click="OpenGitHubSupport_Click" Padding="10,8"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="#FFF0E8" BorderBrush="#E8B99F"
                                BorderThickness="1" CornerRadius="11" Padding="16,13" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="UpdateTitleText" Text="يتوفر تحديث جديد" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}"/>
                                    <TextBlock x:Name="UpdateMessageText" TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                                    <Button Content="تفاصيل" Style="{StaticResource SecondaryButton}" Click="OpenReleaseNotes_Click" Padding="13,7" Margin="0,0,7,0"/>
                                    <Button Content="تحميل التحديث" Style="{StaticResource PrimaryButton}" Click="DownloadUpdate_Click" Padding="13,7"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="AnnouncementBanner" Visibility="Collapsed" Background="#EEF2EA" BorderBrush="#CFD9CB"
                                BorderThickness="1" CornerRadius="11" Padding="16,13" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="AnnouncementTitleText" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AnnouncementMessageText" TextWrapping="Wrap" FontSize="10.5"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="AnnouncementButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                        Click="OpenAnnouncement_Click" Padding="13,7" VerticalAlignment="Center" Margin="18,0,0,0"/>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource SidebarBrush}" CornerRadius="15" Padding="24,21">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#30483A" CornerRadius="9" Padding="9,5" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="#73BD8E" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="جاهز" Foreground="#BDE0C9" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="يعمل في الخلفية" Foreground="#A9AEA7" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusTitle}" FontSize="21" FontWeight="SemiBold" Foreground="#FBF9F3" Margin="0,11,0,0"/>
                                    <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="#A9AEA7" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                                    <TextBlock Text="تشغيل" FontSize="12" Foreground="#C7CBC5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="التصحيح السريع" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                                            <TextBlock Text="↯" FontSize="16" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="حدّد النص ثم استخدم الاختصار" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,12"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" FlowDirection="LeftToRight">
                                        <Border Background="#F0EEE8" CornerRadius="6" Padding="9,5"><TextBlock Text="Ctrl" FontFamily="Consolas" FontSize="12"/></Border>
                                        <TextBlock Text="+" Margin="6,4" Foreground="{StaticResource MutedTextBrush}"/>
                                        <Border Background="#F0EEE8" CornerRadius="6" Padding="9,5"><TextBlock Text="Alt" FontFamily="Consolas" FontSize="12"/></Border>
                                        <TextBlock Text="+" Margin="6,4" Foreground="{StaticResource MutedTextBrush}"/>
                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="10,5"><TextBlock Text="K" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource AccentDarkBrush}"/></Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="اتجاه الكتابة" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="{StaticResource SuccessSoftBrush}">
                                            <TextBlock Text="أ A" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding CurrentLayout}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,10"
                                               TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="2" Text="Arabic 101  /  English US" FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource SuccessBrush}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="24">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="184"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="تجربة التحويل" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="اكتب النص كما ظهر بالخطأ، وسنستعيد التخطيط المقصود فوراً."
                                                   FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" Width="174" VerticalAlignment="Center"
                                              ItemsSource="{Binding DirectionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding PreferredDirection}" FlowDirection="RightToLeft"/>
                                </Grid>
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,17"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="النص المكتوب" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,7"/>
                                        <TextBox Text="{Binding PreviewInput, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap"
                                                 AcceptsReturn="True" FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="⇄" Command="{Binding ConvertPreviewCommand}" Width="38" Height="38"
                                            Style="{StaticResource PrimaryButton}" Padding="0" VerticalAlignment="Center" FontSize="17"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="النتيجة" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,7"/>
                                        <TextBox Text="{Binding PreviewOutput, Mode=OneWay}" Height="80" IsReadOnly="True" TextWrapping="Wrap" FlowDirection="RightToLeft"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#E7EEE9" BorderBrush="#C9DBCF" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="25" Height="25" CornerRadius="7" Background="#D3E3D9" Margin="0,0,10,0">
                                    <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="خصوصيتك محفوظة — المعالجة محلية بالكامل، ولا يُحفظ أو يُرسل أي نص."
                                           FontSize="12" Foreground="#3E654D" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="30,22,30,28" MaxWidth="980" HorizontalAlignment="Stretch">
                        <TextBlock Text="التفضيلات" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="الإعدادات" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="تحكّم بطريقة عمل KeyFix على جهازك." FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,15"/>

                        <Border Style="{StaticResource CardStyle}" Padding="20,17">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="السلوك العام" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBlock Text="خيارات بسيطة تبقى متزامنة مع طريقة عملك." FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#E7EEE9" BorderBrush="#C9DBCF" BorderThickness="1" CornerRadius="9" Padding="11,7" Margin="14,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="اقتراحات ذكية" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="محلية ولا تحفظ النص" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableSmartSuggestions}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <UniformGrid Columns="2" Rows="2">
                                    <Border Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,5,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="تغيير لغة الكيبورد" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="بعد التصحيح تلقائياً" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SwitchLayoutAfterCorrection}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="5,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="إشعارات خفيفة" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="نتيجة هادئة من أيقونة النظام" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowNotifications}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,5,5,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="التصحيح مع الزر الأيمن" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="إجراء سريع قرب قائمة السياق" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowRightClickAction}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="5,5,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="تشغيل مع Windows" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="يبدأ تلقائياً بعد تسجيل الدخول" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="اختصارات النظام" FontSize="17" FontWeight="SemiBold"/>
                                    <Grid Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="النص المحدد" Foreground="{StaticResource MutedTextBrush}" Margin="0,6"/>
                                        <Border Grid.Column="1" Background="#F0EEE8" CornerRadius="6" Padding="8,4" Margin="0,3"><TextBlock Text="Ctrl + Alt + K" FontFamily="Consolas" FontSize="11"/></Border>
                                        <TextBlock Grid.Row="1" Text="آخر كلمة" Foreground="{StaticResource MutedTextBrush}" Margin="0,6"/>
                                        <Border Grid.Row="1" Grid.Column="1" Background="#F0EEE8" CornerRadius="6" Padding="8,4" Margin="0,3"><TextBlock Text="Ctrl + Alt + Space" FontFamily="Consolas" FontSize="11"/></Border>
                                        <TextBlock Grid.Row="2" Text="التراجع" Foreground="{StaticResource MutedTextBrush}" Margin="0,6"/>
                                        <Border Grid.Row="2" Grid.Column="1" Background="#F0EEE8" CornerRadius="6" Padding="8,4" Margin="0,3"><TextBlock Text="Ctrl + Alt + Z" FontFamily="Consolas" FontSize="11"/></Border>
                                        <TextBlock Grid.Row="3" Text="إيقاف / تشغيل" Foreground="{StaticResource MutedTextBrush}" Margin="0,6"/>
                                        <Border Grid.Row="3" Grid.Column="1" Background="#F0EEE8" CornerRadius="6" Padding="8,4" Margin="0,3"><TextBlock Text="Ctrl + Alt + P" FontFamily="Consolas" FontSize="11"/></Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="التطبيقات المستثناة" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="لن يجري التصحيح داخل هذه التطبيقات." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,13"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewExcludedApplication, UpdateSourceTrigger=PropertyChanged}" ToolTip="مثال: Code أو KeePass"/>
                                        <Button Grid.Column="2" Content="إضافة" Command="{Binding AddExcludedApplicationCommand}" Style="{StaticResource PrimaryButton}" Padding="15,10"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding ExcludedApplications}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <Button Grid.Column="1" Content="حذف" Padding="10,5" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding DataContext.RemoveExcludedApplicationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- About -->
                <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="34,35" HorizontalAlignment="Center" Width="620">
                        <Border Width="78" Height="78" CornerRadius="19" Background="{StaticResource SidebarBrush}" Margin="0,8,0,18">
                            <Grid>
                                <TextBlock Text="K" FontSize="38" FontWeight="SemiBold" Foreground="#F7F4EC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="13"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="KeyFix" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="الإصدار 1.4.1" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,22"/>
                        <Border Style="{StaticResource CardStyle}" Padding="30">
                            <StackPanel>
                                <TextBlock Text="اكتب بسرعة. وصحّح بهدوء." FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="يعيد KeyFix تفسير النص المكتوب بتخطيط لوحة مفاتيح خاطئ، من العربي إلى الإنكليزي أو بالعكس. يعمل محلياً على جهازك، بلا حساب وبلا اتصال بالإنترنت."
                                           TextWrapping="Wrap" TextAlignment="Center" LineHeight="24" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="10,13"/>
                                <Border Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,8,0,0">
                                    <TextBlock Text="Arabic 101   ⇄   English US" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource AccentDarkBrush}"
                                               FlowDirection="LeftToRight" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="22,18" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="خلك قريب من المشروع" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="متابعتك واشتراكك يدعمان استمرار KeyFix وتطويره، لكنهما اختياريان بالكامل."
                                           TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="8,5,8,13"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="AboutInstagramButton" Grid.Column="0" Content="Instagram   @22r2z" Style="{StaticResource SecondaryButton}"
                                            Click="OpenInstagram_Click" Padding="15,9" FlowDirection="LeftToRight"/>
                                    <Button x:Name="AboutTelegramButton" Grid.Column="2" Content="Telegram   @Civil_Sajad" Style="{StaticResource PrimaryButton}"
                                            Click="OpenTelegram_Click" Padding="15,9" FlowDirection="LeftToRight"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="مبني بـ .NET 10 و WPF" Foreground="#8B8E87" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
